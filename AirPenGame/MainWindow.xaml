<Window x:Class="AirPenGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPen - Reflex Trainer" Height="700" Width="1000" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="2" Direction="270" Color="#20000000" Opacity="0.5"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#004C93"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E6E8EA"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D5D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Background="#F3F4F6" MouseLeftButtonDown="MainGrid_MouseLeftButtonDown">

        <TextBlock x:Name="MessageText" 
                   FontSize="36" FontWeight="SemiBold" Foreground="#202020" 
                   TextWrapping="Wrap" TextAlignment="Center" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,80,20,0">
        </TextBlock>

        <Viewbox x:Name="ArrowContainer" Visibility="Collapsed" Width="250" Height="250" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="100" Height="100">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="ArrowRotateTransform" Angle="0" CenterX="50" CenterY="50"/>
                </Grid.RenderTransform>
                <Path Fill="#FF1A1A" Stroke="Black" StrokeThickness="3" StrokeLineJoin="Round" Stretch="None" Data="M 10,35 L 50,35 L 50,15 L 90,50 L 50,85 L 50,65 L 10,65 Z"/>
            </Grid>
        </Viewbox>

        <Canvas x:Name="AimLabCanvas" Visibility="Collapsed" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border x:Name="MainMenuPanel" Visibility="Visible" Background="White" CornerRadius="12" Padding="50" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="AirPen Reflex Trainer" FontSize="36" FontWeight="Bold" Foreground="#202020" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Rozpocznij grę" FontSize="22" Padding="40,15" Margin="10" Click="BtnPlay_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Przeglądaj rankingi" FontSize="20" Padding="40,15" Margin="10" Click="BtnLeaderboard_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Wyjdź z aplikacji" FontSize="16" Padding="40,15" Margin="10,40,10,0" Background="#FFE5E5" Foreground="#CE2636" Click="BtnExitApp_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="GameSelectionPanel" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="Wybierz tryb testu" FontSize="28" FontWeight="Bold" Foreground="#202020" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Szybkość reakcji" FontSize="18" Padding="20,12" Margin="5" Click="StartVariant1_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Strzałki kierunkowe" FontSize="18" Padding="20,12" Margin="5" Click="StartVariant2_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Precyzja celowania" FontSize="18" Padding="20,12" Margin="5" Click="StartVariant3_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Wróć" FontSize="16" Padding="20,10" Margin="5,25,5,5" Click="BtnBackToMenu_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="LeaderboardSelectionPanel" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="WYBIERZ RODZAJ" FontSize="28" FontWeight="Bold" Foreground="#202020" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Szybkość reakcji" FontSize="18" Padding="20,12" Margin="5" Click="BtnLeaderboardVariant1_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Strzałki kierunkowe" FontSize="18" Padding="20,12" Margin="5" Click="BtnLeaderboardVariant2_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Precyzja celowania" FontSize="18" Padding="20,12" Margin="5" Click="BtnLeaderboardVariant3_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Wróć" FontSize="16" Padding="20,10" Margin="5,25,5,5" Click="BtnBackToMenu_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="LeaderboardPanel" Visibility="Collapsed" Background="White" CornerRadius="12" Margin="50" Padding="30" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LeaderboardTitle" Grid.Row="0" Text="SALA CHWAŁY" FontSize="28" FontWeight="Bold" Foreground="#202020" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <DataGrid x:Name="LeaderboardGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="1" BorderBrush="#E6E8EA" 
                          RowBackground="White" AlternatingRowBackground="#F9FAFB" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E8EA"
                          FontSize="16" HeadersVisibility="Column" RowHeight="35"/>

                <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Content="Wróć" FontSize="18" Padding="30,10" Margin="0,20,0,0" HorizontalAlignment="Center" Click="BtnBackToLeaderboardSelection_Click"/>
            </Grid>
        </Border>

        <StackPanel x:Name="ResultButtonsPanel" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,50">
            <Button Style="{StaticResource PrimaryButton}" Content="Zapisz wynik" FontSize="20" Padding="30,15" Margin="10" Click="BtnShowSavePopup_Click"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Powrót" FontSize="20" Padding="30,15" Margin="10" Click="BtnReturnFromGame_Click"/>
        </StackPanel>

        <Grid x:Name="SaveScorePopup" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="12" Width="400" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" Effect="{StaticResource CardShadow}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Zapisz swój wynik!" FontSize="22" FontWeight="Bold" Foreground="#202020" TextAlignment="Center" Margin="0,0,0,20"/>
                    <TextBox x:Name="PlayerNameTextBox" FontSize="20" Padding="8" Margin="0,0,0,25" Background="#F3F4F6" BorderBrush="#D1D5D9" BorderThickness="1"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="Zapisz" FontSize="16" Padding="25,10" Margin="10,0" Click="BtnConfirmSave_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Anuluj" FontSize="16" Padding="25,10" Margin="10,0" Click="BtnCancelSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Button x:Name="BtnQuitGame" Visibility="Collapsed" Style="{StaticResource SecondaryButton}" Content="Opuść grę" FontSize="16" Padding="20,10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Click="BtnQuitGame_Click"/>
    </Grid>
</Window>