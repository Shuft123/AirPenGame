<Window x:Class="AirPenGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPen - Reflex Trainer" Height="600" Width="800" Loaded="Window_Loaded">

    <Grid x:Name="MainGrid" Background="#2B87D1" MouseLeftButtonDown="MainGrid_MouseLeftButtonDown">

        <TextBlock x:Name="MessageText" 
                   Text="AirPen Reflex Trainer" 
                   FontSize="36" 
                   FontWeight="SemiBold"
                   Foreground="White" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top"
                   Margin="20, 80, 20, 0"/>

        <Viewbox x:Name="ArrowContainer" 
         Visibility="Collapsed" 
         Width="250" Height="250" 
         Stretch="Uniform"
         HorizontalAlignment="Center" 
         VerticalAlignment="Center">
            <Grid Width="100" Height="100">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="ArrowRotateTransform" Angle="0" CenterX="50" CenterY="50"/>
                </Grid.RenderTransform>
                <Path Fill="#CE2636" Stretch="None">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="10,35" IsClosed="True">
                                <LineSegment Point="50,35"/>
                                <LineSegment Point="50,15"/>
                                <LineSegment Point="90,50"/>
                                <LineSegment Point="50,85"/>
                                <LineSegment Point="50,65"/>
                                <LineSegment Point="10,65"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Grid>
        </Viewbox>

        <StackPanel x:Name="MenuPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,50">
            <Button Content="Tryb 1: Szybkość reakcji" FontSize="20" Padding="15" Margin="10" Click="StartVariant1_Click"/>
            <Button Content="Tryb 2: Strzałki kierunkowe" FontSize="20" Padding="15" Margin="10" Click="StartVariant2_Click"/>
        </StackPanel>

    </Grid>
</Window>